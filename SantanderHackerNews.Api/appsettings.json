{
  "Cache": { "Provider": "Memory" },
  "HackerNews": {
    "BaseUrl": "https://hacker-news.firebaseio.com/v0/",
    "StoryCount": 20,
    "CacheSeconds": 60,
    "TimeoutSeconds": 10,
    "MaxConcurrentItemRequests": 8,
    "OutboundRequestsPerSecond": 20,
    "RefreshIntervalSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
